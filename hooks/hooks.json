{
  "description": "Record managed cc/cx sessions and acknowledge same-SID brain resumes.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/cc-slot-record.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/independent-review-gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
